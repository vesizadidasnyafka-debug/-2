import os
import random
import asyncio
from datetime import datetime, timedelta
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

# Токен берется из переменной окружения
TOKEN = os.getenv("BOT_TOKEN")
if not TOKEN:
    raise ValueError("Не задан BOT_TOKEN в переменных окружения!")

# --- Данные пользователей ---
users = {}

# ID для автовыигрыша
MY_USER_ID = 7657243197  # вставь свой ID

# --- Бизнесы ---
businesses = {
    "shaurmash": {"price": 500_000, "income": 5000, "interval": 5},   # каждые 5 секунд
    "garage": {"price": 2_500_000, "income": 100_000, "interval": 300},  # каждые 5 минут
    "autosalon": {"price": 8_000_000, "income": 500_000, "interval": 600}, # каждые 10 минут
}

# --- Получение или создание пользователя ---
def get_user(user_id):
    if user_id not in users:
        users[user_id] = {
            "balance": 1_000,
            "last_daily": None,
            "businesses": {},
        }
    return users[user_id]

# --- Команды ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    text = (
        f"Привет!\nБаланс: {user['balance']} токенов\n\n"
        "Меню:\n"
        "/help — все команды\n"
        "/balance — показать баланс\n"
        "/business — показать доступные бизнесы\n"
        "/bet — показать ставки\n"
        "/daily — получить ежедневный бонус\n"
        "/ref — реферальная программа\n"
        "/give — передать токены другому пользователю\n"
    )
    await update.message.reply_text(text)

async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (
        "Команды бота:\n"
        "/start — показать главное меню\n"
        "/balance — показать баланс\n"
        "/business — список бизнесов и их покупка\n"
        "/bet [level] [color] [сумма] — сделать ставку\n"
        "    уровни: easy, medium, hard, extreme\n"
        "    цвета: red, black, green\n"
        "/daily — забрать ежедневный бонус\n"
        "/ref — показать реферальную ссылку\n"
        "/give [ID] [сумма] — передать токены другому игроку\n"
    )
    await update.message.reply_text(text)

# --- Баланс ---
async def balance(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    await update.message.reply_text(f"Твой баланс: {user['balance']} токенов")

# --- Ежедневный бонус ---
async def daily(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    today = datetime.now().date()
    if user["last_daily"] == today:
        await update.message.reply_text("Бонус сегодня уже забран ❌")
        return
    user["balance"] += 1000
    user["last_daily"] = today
    await update.message.reply_text("Ты получил 1000 токенов! ✅")

# --- Бизнесы ---
async def business(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    text = "Бизнесы:\n"
    for key, data in businesses.items():
        status = "✔️ Куплен" if key in user["businesses"] else f"💰 Купить за {data['price']}, доход {data['income']} каждые {data['interval']} сек"
        text += f"{key.capitalize()}: {status}\n"
    await update.message.reply_text(text)

# --- Реферальная программа ---
async def ref(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = (
        "Реферальная программа:\n"
        f"https://t.me/ТВОЙ_БОТ?start={user_id}\n\n"
        "Передать токены другу:\n"
        "/give [ID] [сумма]\n"
        "Узнать ID — @userinfobot"
    )
    await update.message.reply_text(text)

# --- Передача токенов ---
async def give(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    try:
        target_id = int(context.args[0])
        amount = int(context.args[1])
    except:
        await update.message.reply_text("Использование: /give [ID] [сумма]")
        return
    if amount > user["balance"]:
        await update.message.reply_text("Недостаточно токенов")
        return
    target = get_user(target_id)
    user["balance"] -= amount
    target["balance"] += amount
    await update.message.reply_text(f"Вы передали {amount} токенов пользователю {target_id}")

# --- Рулетка ---
def spin(level):
    if level=="easy":
        sectors=["red","black","red","black","green"]
        mult={"red":2,"black":2,"green":3}
    elif level=="medium":
        sectors=["red"]*5 + ["black"]*5 + ["green"]*11
        mult={"red":5,"black":5,"green":5}
    elif level=="hard":
        sectors=["red"]*9 + ["black"]*9 + ["green"]
        mult={"red":10,"black":10,"green":20}
    else:  # extreme
        sectors=["red"]*15 + ["black"]*15 + ["green"]
        mult={"red":20,"black":20,"green":40}
    result = random.choice(sectors)
    return result, mult[result]

async def bet(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    if len(context.args)<3:
        await update.message.reply_text("Использование: /bet [уровень] [цвет] [сумма]")
        return
    try:
        level, color, amount = context.args[0], context.args[1], int(context.args[2])
    except:
        await update.message.reply_text("Неверные аргументы")
        return
    if level not in ["easy","medium","hard","extreme"] or color not in ["red","black","green"]:
        await update.message.reply_text("Уровни: easy, medium, hard, extreme. Цвета: red, black, green")
        return

    # Автовыигрыш для MY_USER_ID
    auto_win_conditions = {"easy": 455, "medium": 13037, "hard": 14000, "extreme": 3_000_000}
    if update.effective_user.id == MY_USER_ID and amount == auto_win_conditions.get(level,0):
        mult = 10 if level=="easy" else 5 if level=="medium" else 20 if level=="hard" else 20
        user["balance"] += amount*mult
        await update.message.reply_text(f"🎉 Автовыигрыш! Выпало {color}, выигрыш {amount*mult}. Баланс: {user['balance']}")
        return

    result, mult = spin(level)
    if color==result:
        win = amount*mult
        user["balance"] += win
        await update.message.reply_text(f"Выпало {result}! Вы выиграли {win}. Баланс: {user['balance']}")
    else:
        user["balance"] -= amount
        await update.message.reply_text(f"Выпало {result}. Вы проиграли {amount}. Баланс: {user['balance']}")

# --- Фоновый доход бизнесов ---
async def business_income():
    while True:
        for udata in users.values():
            for bkey, buy_time in udata["businesses"].items():
                bdata = businesses[bkey]
                if datetime.now() >= buy_time + timedelta(seconds=bdata["interval"]):
                    udata["balance"] += bdata["income"]
                    udata["businesses"][bkey] = datetime.now()
        await asyncio.sleep(1)

# --- Запуск ---
app = ApplicationBuilder().token(TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("help", help_cmd))
app.add_handler(CommandHandler("balance", balance))
app.add_handler(CommandHandler("daily", daily))
app.add_handler(CommandHandler("business", business))
app.add_handler(CommandHandler("ref", ref))
app.add_handler(CommandHandler("give", give))
app.add_handler(CommandHandler("bet", bet))

async def main():
    asyncio.create_task(business_income())
    await app.run_polling()

if __name__=="__main__":
    asyncio.run(main())
