import os
import random
import asyncio
from datetime import datetime, timedelta
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes, CallbackQueryHandler

# Токен берется из переменной окружения
TOKEN = os.getenv("BOT_TOKEN")  
if not TOKEN:
    raise ValueError("Переменная окружения BOT_TOKEN не задана!")

# --- Данные пользователей ---
users = {}
last_bet_time = {}  # cooldown ставок

# ID для автоматического выигрыша
MY_USER_ID = 123456789  # вставь свой ID

# --- Словарь бизнесов ---
businesses = {
    "shaurmash": {"price": 500_000, "income": 5000, "interval": 5},   # каждые 5 секунд
    "garage": {"price": 2_500_000, "income": 100_000, "interval": 300},  # каждые 5 минут
    "autosalon": {"price": 8_000_000, "income": 500_000, "interval": 600}, # каждые 10 минут
}

# --- Получение или создание пользователя ---
def get_user(user_id):
    if user_id not in users:
        users[user_id] = {
            "balance": 1_000,
            "last_daily": None,
            "businesses": {},
        }
    return users[user_id]

# --- Основные команды ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)

    keyboard = [
        [InlineKeyboardButton("💰 Сделать ставку", callback_data="menu_bet")],
        [InlineKeyboardButton("👜 Бизнесы", callback_data="menu_business")],
        [InlineKeyboardButton("🎁 Ежедневный бонус", callback_data="menu_daily")],
        [InlineKeyboardButton("🔗 Реферальная программа", callback_data="menu_ref")],
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text(
        f"Привет!\nБаланс: {user['balance']} токенов",
        reply_markup=reply_markup
    )

# --- /daily ---
async def daily(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    today = datetime.now().date()
    if user["last_daily"] == today:
        await update.message.reply_text("Бонус сегодня уже забран ❌")
        return
    user["balance"] += 1000
    user["last_daily"] = today
    await update.message.reply_text("Ты получил 1000 токенов! ✅")

# --- Баланс ---
async def balance(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    await update.message.reply_text(f"Твой баланс: {user['balance']} токенов")

# --- Рулетка ---
def spin(level):
    if level=="easy":
        sectors=["red","black","red","black","green"]
        mult={"red":2,"black":2,"green":3}
    elif level=="medium":
        sectors=["red"]*5 + ["black"]*5 + ["green"]*11
        mult={"red":5,"black":5,"green":5}
    elif level=="hard":
        sectors=["red"]*9 + ["black"]*9 + ["green"]
        mult={"red":10,"black":10,"green":20}
    else:  # extreme
        sectors=["red"]*15 + ["black"]*15 + ["green"]
        mult={"red":20,"black":20,"green":40}
    result = random.choice(sectors)
    return result, mult[result]

# --- Обработка ставок ---
async def bet(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user = get_user(query.from_user.id)

    keyboard = [
        [InlineKeyboardButton("Easy (x2/x2/x3)", callback_data="bet_easy")],
        [InlineKeyboardButton("Medium (x5/x5/x5)", callback_data="bet_medium")],
        [InlineKeyboardButton("Hard (x10/x10/x20)", callback_data="bet_hard")],
        [InlineKeyboardButton("Extreme (x20/x20/x40)", callback_data="bet_extreme")]
    ]
    await query.edit_message_text(
        f"Выбери уровень ставки, твой баланс: {user['balance']}",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def place_bet(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user = get_user(query.from_user.id)

    level = query.data.split("_")[1]  # easy, medium, hard, extreme

    # минимальная ставка для Extreme
    min_bet = 1_000_000 if level=="extreme" else 1
    max_bet = 1_000_000_000 if level!="extreme" else None

    await query.edit_message_text(
        f"Введите сумму ставки (мин: {min_bet}{' макс: '+str(max_bet) if max_bet else ''})"
    )
    context.user_data["current_level"] = level

# --- Реферальная программа ---
async def ref_program(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.effective_user.id)
    code = update.effective_user.id
    await update.callback_query.message.reply_text(
        f"Ваш реферальный код: {code}\nПоделитесь с друзьями, чтобы получить бонус!\n\n"
        "Чтобы передать токены другу: /give [ID] [сумма]\n\n"
        "Узнать свой ID можно через @userinfobot"
    )

# --- Бизнесы ---
async def business_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = get_user(update.callback_query.from_user.id)
    keyboard = []
    for key, data in businesses.items():
        status = "✔️ Куплен" if key in user["businesses"] else f"💰 Купить {data['price']}"
        keyboard.append([InlineKeyboardButton(f"{key.capitalize()} — {status}", callback_data=f"buy_{key}")])
    await update.callback_query.edit_message_text(
        "Выберите бизнес:", reply_markup=InlineKeyboardMarkup(keyboard)
    )

async def buy_business(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user = get_user(query.from_user.id)
    business_key = query.data.split("_")[1]

    if business_key in user["businesses"]:
        await query.edit_message_text(f"Бизнес {business_key.capitalize()} уже куплен ❌")
        return

    data = businesses[business_key]
    if user["balance"] < data["price"]:
        await query.edit_message_text("Недостаточно токенов для покупки ❌")
        return

    user["balance"] -= data["price"]
    user["businesses"][business_key] = datetime.now()
    await query.edit_message_text(f"Вы купили бизнес {business_key.capitalize()} ✅ Баланс: {user['balance']}")

# --- Фоновый доход от бизнесов ---
async def business_income():
    while True:
        for user_id, udata in users.items():
            for bkey, buy_time in udata["businesses"].items():
                bdata = businesses[bkey]
                if datetime.now() >= buy_time + timedelta(seconds=bdata["interval"]):
                    udata["balance"] += bdata["income"]
                    udata["businesses"][bkey] = datetime.now()
        await asyncio.sleep(1)

# --- Главная точка ---
app = ApplicationBuilder().token(TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("balance", balance))
app.add_handler(CallbackQueryHandler(bet, pattern="^menu_bet$"))
app.add_handler(CallbackQueryHandler(place_bet, pattern="^bet_"))
app.add_handler(CallbackQueryHandler(business_menu, pattern="^menu_business$"))
app.add_handler(CallbackQueryHandler(buy_business, pattern="^buy_"))
app.add_handler(CallbackQueryHandler(daily, pattern="^menu_daily$"))
app.add_handler(CallbackQueryHandler(ref_program, pattern="^menu_ref$"))

# --- Запуск фоновой задачи ---
async def main():
    asyncio.create_task(business_income())
    await app.run_polling()

if __name__ == "__main__":
    asyncio.run(main())
